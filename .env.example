# Copy to .env and fill in from mimOE Studio -> AI Models -> (load model) -> API button
MIMOE_BASE_URL=http://localhost:8083/mimik-ai/openai/v1
MIMOE_API_KEY=paste-key-from-studio
MIMOE_MODEL=qwen3-1.7b
MAX_STEPS=5
MAX_TOKENS=512
# Chat history budget in characters (~3.5 chars per token); raise it if your context is bigger than 2048
MAX_HISTORY_CHARS=4000
# 1 = let Qwen3 reason in <think> blocks before answering (slower, sometimes better tool choice)
THINKING=0
# Set if Node shows the wrong local time (e.g. Windows "British Columbia Standard Time"): IANA zone name
# TZ=America/Vancouver
DEBUG=0
